{
  "name": "deliveryassist-ai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "DeliveryAssist AI: demo de operações de delivery com aprovação humana",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "vite --config client/vite.config.js",
    "start": "node server/src/index.js",
    "build": "vite build --config client/vite.config.js",
    "lint": "eslint .",
    "test": "npm run test:unit && npm run test:frontend",
    "test:integration": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --testMatch=**/*.integration.test.js",
    "test:e2e": "playwright test",
    "check": "npm run lint && npm test && npm run build",
    "db:migrate": "node server/scripts/migrate.js",
    "db:seed": "node server/scripts/seed.js",
    "demo:reset": "node server/scripts/reset.js",
    "deploy:cloudflare": "npm run build && wrangler deploy",
    "deploy:check": "npm run build && wrangler deploy --dry-run --outdir .wrangler-build",
    "test:unit": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand --testPathIgnorePatterns=.integration.test.js",
    "test:frontend": "vitest run --config client/vite.config.js",
    "test:native": "node --test server/tests/native.test.mjs",
    "eval:ai": "node scripts/ai-eval.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@mui/icons-material": "^7.3.0",
    "@mui/material": "^7.3.0",
    "@tanstack/react-query": "^5.83.0",
    "bcryptjs": "^3.0.2",
    "dotenv": "^17.2.0",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.16.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.7.0",
    "zustand": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.31.0",
    "globals": "^16.3.0",
    "jsdom": "^26.1.0",
    "supertest": "^7.1.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "wrangler": "^4.37.0",
    "jest": "^30.0.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "workerd@1.20261113.1": true,
    "@parcel/watcher@2.6.0": true
  }
}
