# Entorno; secrets exclusivamente no servidor (Wrangler secrets para Cloudflare).
NODE_ENV=development
PORT=3001
APP_BASE_URL=http://localhost:3001
# Banco PostgreSQL, exemplo local; configurar credencial privada fora do Git
DATABASE_URL=
JWT_SECRET=
CSRF_SECRET=
DEMO_MODE=true
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
DEMO_OPERATOR_EMAIL=
DEMO_OPERATOR_PASSWORD=
DEMO_PUBLIC_LOGIN=false
DEMO_RESET_HOURS=24
SEED_RANDOM_SEED=2026
LATE_GRACE_MINUTES=5
SESSION_MAX_HOURS=8
AI_ENABLED=false
AI_PROVIDER=openai_compatible
AI_MODEL=
AI_API_KEY=
AI_BASE_URL=
AI_ALLOWED_HOSTS=api.openai.com,generativelanguage.googleapis.com
AI_TIMEOUT_MS=20000
AI_TURN_TIMEOUT_MS=45000
AI_MAX_OUTPUT_TOKENS=700
AI_DAILY_GLOBAL_LIMIT=30
AI_DAILY_SESSION_LIMIT=10
AI_DAILY_USER_LIMIT=25
AI_SESSION_PER_MINUTE_LIMIT=3
TRUST_PROXY=false
LOG_LEVEL=info
# Somente testes isolados
TEST_DATABASE_URL=
